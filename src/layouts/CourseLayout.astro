---
import CourseSidebar from '../components/CourseSidebar.astro';
import LessonHero from '../components/LessonHero.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import '../styles/global.css';
const { title, subtitle, eyebrow, currentSlug = '', completionMode = 'scroll', heroActionHref, heroActionLabel } = Astro.props;
---
<!doctype html>
<html lang="en" data-current-lesson={currentSlug} data-completion-mode={completionMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Regulatory Pre-appointment Readiness e-learning course" />
    <link rel="icon" href="/images/brand/tfg-logo.svg" type="image/svg+xml" />
    <title>Content</title>
  </head>
  <body>
    <div class="shell">
      <CourseSidebar currentSlug={currentSlug} />
      <main class="course-main">
        <LessonHero title={title} subtitle={subtitle} eyebrow={eyebrow} actionHref={heroActionHref} actionLabel={heroActionLabel} />
        <div class="container content-stack"><slot /></div>
        <footer class="course-footer"><div class="container">Return to People Connect to continue</div></footer>
      </main>
    </div>
    <ImageLightbox />
    <script is:inline src="/scripts/scorm.js"></script>
    <script is:inline src="/scripts/course.js"></script>
  </body>
</html>
