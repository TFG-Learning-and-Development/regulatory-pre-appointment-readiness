<dialog class="image-lightbox" data-image-lightbox aria-labelledby="image-lightbox-title">
  <div class="image-lightbox-panel">
    <div class="image-lightbox-header">
      <h2 id="image-lightbox-title">Enlarged image</h2>
      <button class="image-lightbox-close focus-ring" type="button" data-lightbox-close>Close</button>
    </div>
    <div class="image-lightbox-content">
      <img src="" alt="" data-lightbox-image />
    </div>
  </div>
</dialog>
