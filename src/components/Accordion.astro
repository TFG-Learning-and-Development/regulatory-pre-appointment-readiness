---
import RichText from './RichText.astro';
const { items = [] } = Astro.props;
---
<div class="accordion">
  {items.map((item, index) => (
    <details open={item.open || index === 0}>
      <summary>{item.title}</summary>
      <div class="accordion-body">
        {item.paragraphs?.map((p) => <p><RichText content={p} /></p>)}
        {item.bullets && <ul>{item.bullets.map((bullet) => <li><RichText content={bullet} /></li>)}</ul>}
        {item.paragraphsAfter?.map((p) => <p><RichText content={p} /></p>)}
      </div>
    </details>
  ))}
</div>
